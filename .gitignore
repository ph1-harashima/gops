# phasep-gulliver は独自の .git を持つ別リポジトリのため、ルートリポジトリの管理対象外とする
phasep-gulliver/

# OS / エディタ
.DS_Store
Thumbs.db
.vscode/
.idea/

# 一時ファイル
*.tmp
~$*

# Production DB backups (real customer data) - never committed, regardless
# of how they are staged (docs/real-data-audit/gops-prod-snapshot-*-stage0.md
# 参照)
docs/real-data-audit/*.7z
docs/real-data-audit/*.dmp
docs/real-data-audit/*.sql

# Scratch working directory for extracted Production backups (Stage 1,
# docs/real-data-audit/gops-prod-snapshot-20260916-stage1-restore.md) -
# entire directory ignored, not just specific extensions, since its whole
# purpose is holding real Production data outside the tracked tree.
.local/

# ---- Added 2026-11-25: accidental-commit prevention (sensitive / real-data / scratch) ----
# Real-data backups & DB dumps. NOTE: *.sql is deliberately NOT ignored wholesale
# (Flyway migrations, demo-data/, e2e-fixtures/ are tracked .sql files).
*.7z
*.dmp
*.dump
*.bak
*.sql.gz
*.sql.zip
_protected_db_snapshots/

# Credentials / session artifacts
cookies*.txt
*.cookie
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
.netrc
.credentials.json
credentials.json
secrets/

# Run logs and root-level scratch captures (API responses / curl logs)
*.log
/log[0-9]*.txt
/pc[0-9]*.json
/pd[0-9]*.json
/psku[0-9]*.json
