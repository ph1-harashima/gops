# phasep-gulliver は独自の .git を持つ別リポジトリのため、ルートリポジトリの管理対象外とする
phasep-gulliver/

# OS / エディタ
.DS_Store
Thumbs.db
.vscode/
.idea/

# 一時ファイル
*.tmp
~$*

# Production DB backups (real customer data) - never committed, regardless
# of how they are staged (docs/real-data-audit/gops-prod-snapshot-*-stage0.md
# 参照)
docs/real-data-audit/*.7z
docs/real-data-audit/*.dmp
docs/real-data-audit/*.sql

# Scratch working directory for extracted Production backups (Stage 1,
# docs/real-data-audit/gops-prod-snapshot-20260916-stage1-restore.md) -
# entire directory ignored, not just specific extensions, since its whole
# purpose is holding real Production data outside the tracked tree.
.local/
