<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.glv.gsysportal</groupId>
  <artifactId>gsys-portal-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>gsys-portal-backend</name>
  <description>
    G-SYS Online Ordering Prototype - New Service API.
    Legacy G-SYS (phasep-gulliver) is READ ONLY and is never modified by this module.
    See docs/G-SYS_Online-Ordering_Prototype_Technical_Design.md for design rationale.
  </description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <!-- Legacy calc classes (jp.ne.glv.legacycalc) use json-simple; pinned to match Legacy pom.xml usage -->
    <json-simple.version>1.1.1</json-simple.version>
  </properties>

  <dependencies>
    <!-- Web / REST -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Prototype DB (PostgreSQL, READ/WRITE) via Spring Data JPA -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Legacy DB (MySQL, READ ONLY) via plain JdbcTemplate - no JPA entities for Legacy -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Phase 9-E: Real Email Send. JavaMailSender is used ONLY by
         SmtpEmailSenderAdapter (@Profile("production") - unreachable here,
         SafetyGuardEnvironmentPostProcessor refuses to start under that
         profile). MailSenderAutoConfiguration is explicitly excluded in
         application.yml so no JavaMailSender bean is ever auto-created in
         local/demo/test - the only Adapter active there is
         LoggingEmailSenderAdapter, which never opens a socket. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>

    <!-- Phase 8-L (Production Reliability Foundation): /actuator/health only
         (Application liveness + Portal DB, via a hand-written HealthIndicator -
         see health/PortalDatabaseHealthIndicator.java). No other actuator
         endpoint is exposed (management.endpoints.web.exposure.include=health
         in application.yml) - this is not a general Metrics/Ops dependency. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Flyway: Prototype DB (PostgreSQL) migrations only. Never applied to Legacy. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Legacy MySQL driver, READ ONLY connection only (see LegacyDataSourceConfig) -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!--
      json-simple: the ONLY external dependency of the verbatim-ported Legacy class
      StockCalculationHelper.java (org.json.simple.JSONObject). Added here so the
      Legacy calc classes can be copied byte-for-byte without modification.
      See Technical Design 4.3.
    -->
    <dependency>
      <groupId>com.googlecode.json-simple</groupId>
      <artifactId>json-simple</artifactId>
      <version>${json-simple.version}</version>
    </dependency>

    <!--
      Phase 7-C2A: OfficialPoExcelGenerator (Excel Generator Foundation).
      A modern version, NOT the Legacy pom.xml's ancient poi/poi-ooxml 3.9 -
      this is new Portal code, not a verbatim port of Legacy Source (that
      distinction only applies to jp.ne.glv.legacycalc, Technical Design 4.3).
    -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi</artifactId>
      <version>5.2.5</version>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.2.5</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- H2: local/offline fallback profile only (Technical Design 2.4) -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>gsys-portal-backend</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
